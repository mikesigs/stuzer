{
  "name": "Stuzer",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "workspaceFolder": "/workspaces/stuzer",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/stuzer,type=bind",
  "containerEnv": {
    "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037",
    "PUB_CACHE": "/caches/pub",
    "GRADLE_USER_HOME": "/caches/gradle"
  },
  "mounts": [
    "source=stuzer-pub-cache,target=/caches/pub,type=volume",
    "source=stuzer-gradle-cache,target=/caches/gradle,type=volume",
    "source=stuzer-android-home,target=/root/.android,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"]
    }
  },
  "postCreateCommand": "git config --global --add safe.directory /workspaces/stuzer && flutter --version",
  "postStartCommand": "flutter doctor"
}
